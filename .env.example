# Accumulate DevNet Configuration

# Network configuration
ACCUMULATE_NETWORK=DevNet
ACCUMULATE_FAUCET_SEED=ci

# Devnet topology
ACCUMULATE_BVNS=2
ACCUMULATE_VALIDATORS=2
ACCUMULATE_FOLLOWERS=0

# Port configuration (base port, other services are offsets from this)
ACCUMULATE_BASE_PORT=26656

# API URLs that will be available
# Bootstrap API: http://localhost:26660
# BVN1 Node 1 API: http://localhost:26760
# BVN1 Node 2 API: http://localhost:26761
# BVN2 Node 1 API: http://localhost:26860
# BVN2 Node 2 API: http://localhost:26861

# Global values override
ACCUMULATE_GLOBALS={"executorVersion": "v2", "oracle": {"price": 50000000}}